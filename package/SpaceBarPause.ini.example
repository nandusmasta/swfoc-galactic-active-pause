; Optional settings for Space Bar Pause.
; To use: rename this file to SpaceBarPause.ini and put it in the game's "corruption" folder
; (next to winmm.dll).
;
; The pause key itself is set in the game: Options > Keyboard > Interface > Pause/Play.

[SpaceBarPause]
; 1 = you can give fleet, production and orbit/surface orders while YOU have paused the game.
; 0 = vanilla behaviour (orders are refused while paused).
AllowOrdersWhilePaused=1
